<script>
const contactInput = document.getElementById('contact');
const currentUserId = <?= $id ?>; // current customer's ID from PHP

contactInput.addEventListener('input', function () {
    const contact = this.value.trim();

    // Clear previous error
    this.setCustomValidity("");

    if (contact === "") return;

    // Must start with 09 and exactly 11 digits
    const regex = /^09\d{9}$/;

    if (!regex.test(contact)) {
        this.setCustomValidity("Contact number must start with 09 and contain 11 digits.");
        return;
    }

    fetch('check_contact.php?contact=' + encodeURIComponent(contact) + '&id=' + currentUserId)
        .then(res => res.json())
        .then(data => {
            // Clear old error first
            // contactInput.setCustomValidity("");

            if (data.exists) {
                contactInput.setCustomValidity("This contact number is already registered.");
            } else {
                this.setCustomValidity("");
            }
        })
        .catch(() => {
            contactInput.setCustomValidity("Unable to verify contact number.");
        });
});
</script>





