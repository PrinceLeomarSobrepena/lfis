        });

         // ✅ After loop: set hiddenProvince once
         $('#hiddenProvince').val(defaultProvince);

        const provinceCode = provinces.find(p => p.province_name === defaultProvince)?.province_code;

        if (provinceCode) {
            $.getJSON("../location/city.json", function(data) {
                cities = data.filter(c => c.province_code === provinceCode);
                $("#city").empty().append('<option value="">-- Select City --</option>');
                cities.forEach(c => {
                    const selected = (c.city_name === defaultCity) ? 'selected' : '';
                    $("#city").append(`<option value="${c.city_name}" ${selected}>${c.city_name}</option>`);
                });

                // ✅ After loop: set hiddenCity once
                $('#hiddenCity').val(defaultCity);

                const cityCode = cities.find(c => c.city_name === defaultCity)?.city_code;
                if (cityCode) {
                    $.getJSON("../location/barangay.json", function(data) {
                        barangays = data.filter(b => b.city_code === cityCode);
                        $("#barangay").empty().append('<option value="">-- Select Barangay --</option>');
                        barangays.forEach(b => {
                            $("#barangay").append(`<option value="${b.brgy_name}">${b.brgy_name}</option>`);
                        });
                    });
                }
            });
        }
    });

    $("#province").on("change", function() {
        const selectedProvince = $(this).val();
        const provinceCode = provinces.find(p => p.province_name === selectedProvince)?.province_code;

        $("#city").empty().append('<option value="">-- Select City --</option>');
        $("#barangay").empty().append('<option value="">-- Select Barangay --</option>');

        if (!provinceCode) return;

        $.getJSON("../location/city.json", function(data) {
            cities = data.filter(c => c.province_code === provinceCode);
            cities.forEach(c => {
                $("#city").append(`<option value="${c.city_name}">${c.city_name}</option>`);
            });
        });
    });

    $("#city").on("change", function() {
        const selectedCity = $(this).val();
        const cityCode = cities.find(c => c.city_name === selectedCity)?.city_code;

        $("#barangay").empty().append('<option value="">-- Select Barangay --</option>');

        if (!cityCode) return;

        $.getJSON("../location/barangay.json", function(data) {
            barangays = data.filter(b => b.city_code === cityCode);
            barangays.forEach(b => {
                $("#barangay").append(`<option value="${b.brgy_name}">${b.brgy_name}</option>`);
            });
        });
    });
});
