<script>
const contactInput = document.getElementById('contact');

contactInput.addEventListener('input', function () {
    const contact = this.value.trim();

    // Reset validation
    this.setCustomValidity("");

    if (contact === "") return;

    // Must start with 09 and exactly 11 digits
    const regex = /^09\d{9}$/;

    if (!regex.test(contact)) {
        this.setCustomValidity("Contact number must start with 09 and contain 11 digits.");
        return;
    }

    // Pass current user id to ignore own contact
    fetch('check_contact.php?contact=' + encodeURIComponent(contact))
        .then(res => res.json())
        .then(data => {
            if (data.exists) {
                this.setCustomValidity("This contact number is already registered.");
            } else {
                this.setCustomValidity("");
            }
        })
        .catch(() => {
            this.setCustomValidity("Unable to verify contact number.");
        });
});
</script>


