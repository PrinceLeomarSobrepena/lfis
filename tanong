<script>
let provinces, cities, barangays;

// VALUES FROM DATABASE (ETO ANG IMPORTANTE)
const defaultProvince = "<?= htmlspecialchars($customer['province']) ?>";
const defaultCity = "<?= htmlspecialchars($customer['city']) ?>";
const defaultBarangay = "<?= htmlspecialchars($customer['barangay']) ?>";

$(document).ready(function () {

    $('#hiddenProvince').val(defaultProvince);
    $('#hiddenCity').val(defaultCity);

    // Load provinces
    $.getJSON("../location/province.json", function (data) {
        provinces = data;

        provinces.forEach(p => {
            const selected = p.province_name === defaultProvince ? 'selected' : '';
            $("#province").append(`<option ${selected}>${p.province_name}</option>`);
        });

        const provinceCode = provinces.find(
            p => p.province_name === defaultProvince
        )?.province_code;

        // Load cities
        $.getJSON("../location/city.json", function (data) {
            cities = data.filter(c => c.province_code === provinceCode);

            cities.forEach(c => {
                const selected = c.city_name === defaultCity ? 'selected' : '';
                $("#city").append(`<option ${selected}>${c.city_name}</option>`);
            });

            const cityCode = cities.find(
                c => c.city_name === defaultCity
            )?.city_code;

            // Load barangays + AUTO SELECT
            $.getJSON("../location/barangay.json", function (data) {
                barangays = data.filter(b => b.city_code === cityCode);

                $("#barangay").append('<option value="">-- Select Barangay --</option>');

                barangays.forEach(b => {
                    const selected = b.brgy_name === defaultBarangay ? 'selected' : '';
                    $("#barangay").append(
                        `<option value="${b.brgy_name}" ${selected}>${b.brgy_name}</option>`
                    );
                });
            });
        });
    });
});
</script>
