CREATE DATABASE capstone1v1;
USE capstone1v1;

-- 1. Table: admin
-- ============================================
CREATE TABLE admin (
    id INT AUTO_INCREMENT PRIMARY KEY,
    firstName VARCHAR(100) NOT NULL,
    lastName VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    contact VARCHAR(20) NOT NULL,
    password VARCHAR(255) NOT NULL,
    role_as VARCHAR(50) NOT NULL DEFAULT 'admin',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
    banned TINYINT(1) DEFAULT 0,

    google_uid VARCHAR(100) DEFAULT NULL,
    picture VARCHAR(255) DEFAULT NULL
);

-- ============================
-- 2. Table: adminLogs
-- ============================
CREATE TABLE adminLogs (
    id INT AUTO_INCREMENT PRIMARY KEY, 
    adminId INT NOT NULL,
    login_time DATETIME DEFAULT NULL,
    logout_time DATETIME DEFAULT NULL,
    status ENUM('online','offline') DEFAULT 'offline',
    FOREIGN KEY (adminId) REFERENCES admin(id) ON DELETE CASCADE
);



-- ============================================
-- 5. Table: staff
-- ============================================
CREATE TABLE staff (
    id INT AUTO_INCREMENT PRIMARY KEY,
    firstName VARCHAR(100) NOT NULL,
    lastName VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL,
    contact VARCHAR(20) NOT NULL,

    password VARCHAR(255) NOT NULL,
    image VARCHAR(255) DEFAULT NULL,
    role_as VARCHAR(50) NOT NULL DEFAULT 'staff',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
    banned TINYINT(1) DEFAULT 0,

    google_uid VARCHAR(100) DEFAULT NULL,
    picture VARCHAR(255) DEFAULT NULL,

    -- new password
    mustChangePassword TINYINT(1) NOT NULL DEFAULT 0
);

-- ============================================
-- 6. Table: staffLogs
-- ============================================
CREATE TABLE staffLogs (
    id INT AUTO_INCREMENT PRIMARY KEY,
    staffId INT NOT NULL,
    login_time DATETIME DEFAULT NULL,
    logout_time DATETIME DEFAULT NULL,
    status ENUM('online', 'offline') DEFAULT 'offline',
    FOREIGN KEY (staffId) REFERENCES staff(id) ON DELETE CASCADE
);


-- ============================================
-- 7. Table: council
-- ============================================
CREATE TABLE council (
    id INT AUTO_INCREMENT PRIMARY KEY,
    firstName VARCHAR(100) NOT NULL,
    lastName VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL,
    contact VARCHAR(20) NOT NULL,

    password VARCHAR(255) NOT NULL,
    image VARCHAR(255) DEFAULT NULL,
    role_as VARCHAR(50) NOT NULL DEFAULT 'council',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
    banned TINYINT(1) DEFAULT 0,

    google_uid VARCHAR(100) DEFAULT NULL,
    picture VARCHAR(255) DEFAULT NULL,

    -- new password
    mustChangePassword TINYINT(1) NOT NULL DEFAULT 0
);

-- ============================================
-- 8. Table: councilLogs
-- ============================================
CREATE TABLE councilLogs (
    id INT AUTO_INCREMENT PRIMARY KEY,
    councilId INT NOT NULL,
    login_time DATETIME DEFAULT NULL,
    logout_time DATETIME DEFAULT NULL,
    status ENUM('online', 'offline') DEFAULT 'offline',
    FOREIGN KEY (councilId) REFERENCES council(id) ON DELETE CASCADE
);


-- ============================================
-- 7. Table: password_resets    
-- ============================================

-- ===========================================
-- 8. customer registration verification

CREATE TABLE lost_found (
    id INT AUTO_INCREMENT PRIMARY KEY,
    category ENUM('Cash','Gadget','Document','Other') NOT NULL,

    reported_location VARCHAR(255) DEFAULT NULL,

    extra_details TEXT DEFAULT NULL,

    status ENUM('Lost','Found') NOT NULL,
    email VARCHAR(100) DEFAULT NULL,
    image VARCHAR(255) DEFAULT 'default.jpg',

    is_claimed TINYINT(1) DEFAULT 0,
    claimed_by VARCHAR(255) DEFAULT NULL,
    claimed_id VARCHAR(255) DEFAULT NULL,
    claimed_email VARCHAR(255) DEFAULT NULL,
    claimed_contact VARCHAR(255) DEFAULT NULL,
    claimed_department ENUM('IT','CRIM') DEFAULT NULL,
    claimed_address VARCHAR(255) DEFAULT NULL,
    claimed_date DATETIME DEFAULT NULL,

    is_returned TINYINT(1) DEFAULT 0,
    returned_by VARCHAR(255) DEFAULT NULL,
    returned_id VARCHAR(255) DEFAULT NULL,
    returned_email VARCHAR(255) DEFAULT NULL,
    returned_contact VARCHAR(255) DEFAULT NULL,
    returned_department ENUM('IT','CRIM') DEFAULT NULL,
    returned_address VARCHAR(255) DEFAULT NULL,
    returned_date DATETIME DEFAULT NULL;

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
