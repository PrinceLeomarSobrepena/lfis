Palitan lang ng:

$update = $conn->prepare("
    UPDATE lost_found
    SET
        is_resolved = 1,
        resolved_reference = ?
    WHERE id IN (?, ?)
");

$update->bind_param(
    "sii",
    $resolved_reference,
    $lost_id,
    $found_id
);

$update->execute();

